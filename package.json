{
  "name": "@moipayway/node",
  "version": "0.1.0",
  "description": "Official Node.js SDK for the MoiPayWay API.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "moipayway",
    "payments",
    "wallets",
    "africa",
    "sdk"
  ],
  "author": "MoiPayWay",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mpwsocial/node.git"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.8.0"
  }
}
