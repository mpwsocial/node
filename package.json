{
  "name": "@moipayway/node",
  "version": "0.1.0",
  "description": "Official MoiPayWay Node.js SDK for merchant REST APIs.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "keywords": ["moipayway", "payments", "wallets", "africa", "sdk"],
  "author": "MoiPayWay",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mpwsocial/node.git"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  }
}
